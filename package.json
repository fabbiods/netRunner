{
  "name": "netrunner",
  "productName": "NetRunner",
  "version": "0.6.0",
  "description": "Terminal web local e seguro para equipamentos de rede",
  "private": true,
  "type": "module",
  "main": "src/server/main.mjs",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "start": "node src/server/main.mjs",
    "benchmark:inventory": "node scripts/benchmark-inventory.mjs",
    "dev": "node src/server/main.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test",
    "verify": "npm run lint && npm test",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "ssh2": "1.17.0"
  }
}
